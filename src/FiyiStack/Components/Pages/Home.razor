@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Solo ejecutamos la lógica de la base de datos la primera vez que se carga el componente
        if (firstRender)
        {
            try
            {
                int CantidadDeUsuarios = await userRepository.CountAsync();
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Exito", $@"Cantidad de usuarios: {CantidadDeUsuarios}", "success");
            }
            catch (Exception ex)
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", ex.Message, "error");
            }
            finally
            {
                // Opcional: Solo si necesitas repintar la pantalla tras el proceso asíncrono
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}