@page "/cms/system/failurenonquerypage/{FailureId:int}"

@inherits FiyiStack.Components.Base.CMSBase;

@using FiyiStack.Areas.System.FailureBack.Repositories;
@using FiyiStack.Areas.System.FailureBack.Entities;
@using FiyiStack.Areas.System.FailureBack.DTOs;

@inject FailureRepository failureRepository;
@inject IJSRuntime IJSRuntime;

<!--FOREIGN CALLS (TABLES)-->


@if (FailureId == 0)
{
    <PageTitle>Agregar failure - System</PageTitle>
}
else
{
    <PageTitle>Editar failure - System</PageTitle>
}

<FiyiStack.Components.Shared.ComponentsForDashboard._SideNavForDashboard lstFoldersAndPagesForSideNavDTO="ListFoldersAndPagesForSideNavDTO"></FiyiStack.Components.Shared.ComponentsForDashboard._SideNavForDashboard>

<div class="main-content position-relative max-height-vh-100 h-100">
    <FiyiStack.Components.Shared.ComponentsForDashboard._NavBarForDashboard Pagina="Failure"></FiyiStack.Components.Shared.ComponentsForDashboard._NavBarForDashboard>
    <div class="container-fluid px-2 px-md-4">
        <div class="page-header min-height-300 border-radius-xl mt-4"
             style="background-image: url('img/System/Landscape.jpg');">
            <span class="mask bg-gradient-dark opacity-6"></span>
        </div>
        <div class="card card-body mx-3 mx-md-4 mt-n6">
            <div class="card-header mb-0 pb-0 px-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h3 class="mb-3 mb-md-0">
                        @if (FailureId == 0)
                        {
                            <span>Agregar failure</span>
                        }
                        else
                        {
                            <span>Editar failure</span>
                        }
                    </h3>
                    <div class="d-flex">
                        <NavLink class="btn btn-white btn-sm" href="CMS/System/FailureQueryPage">
                            <span class="fas fa-chevron-left"></span>
                            &nbsp;
                            Volver
                        </NavLink>
                    </div>
                </div>
                <div class="alert alert-info text-white" role="alert">
                    Los campos marcados con <span class="text-danger">*</span> son obligatorios
                </div>
                <hr class="mt-3" />
            </div>
            <div class="card-body px-4">
                <form method="post" @onsubmit="Submit"
                      @formname="failure-form" class="mb-4">
                    <AntiforgeryToken />
                    <!--Message-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="message">
                            Message
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageMessage != "")
                            {
                                @((MarkupString)ErrorMessageMessage)
                            }
                        </label>
                        <textarea rows="10"
                        class="form-control pt-0"
                        value="@Failure!.Message"
                        @onchange="HandleMessageChange"
                        id="message">
                        </textarea>
                    </div>
                    <!--EmergencyLevel-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="emergencylevel">
                            EmergencyLevel
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageEmergencyLevel != "")
                            {
                                @((MarkupString)ErrorMessageEmergencyLevel)
                            }
                        </label>
                        <input type="number"
                        step="1" 
                        id="emergencylevel"
                        class="form-control pt-0"
                        value="@Failure!.EmergencyLevel"
                        @onchange="HandleEmergencyLevelChange" />
                    </div>
                    <!--StackTrace-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="stacktrace">
                            StackTrace
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageStackTrace != "")
                            {
                                @((MarkupString)ErrorMessageStackTrace)
                            }
                        </label>
                        <textarea rows="10"
                        class="form-control pt-0"
                        value="@Failure!.StackTrace"
                        @onchange="HandleStackTraceChange"
                        id="stacktrace">
                        </textarea>
                    </div>
                    <!--Source-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="source">
                            Source
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageSource != "")
                            {
                                @((MarkupString)ErrorMessageSource)
                            }
                        </label>
                        <textarea rows="10"
                        class="form-control pt-0"
                        value="@Failure!.Source"
                        @onchange="HandleSourceChange"
                        id="source">
                        </textarea>
                    </div>
                    <!--Comment-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="comment">
                            Comment
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageComment != "")
                            {
                                @((MarkupString)ErrorMessageComment)
                            }
                        </label>
                        <textarea rows="10"
                        class="form-control pt-0"
                        value="@Failure!.Comment"
                        @onchange="HandleCommentChange"
                        id="comment">
                        </textarea>
                    </div>
                    
                    <hr />
                    @((MarkupString)Message)
                    <div class="d-flex justify-content-between">
                        <button id="btn-submit" 
                        type="submit"
                        class="btn btn-success"
                        disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>&nbsp;Guardando...</span>
                            }
                            else
                            {
                                <i class="fas fa-pen"></i>
                                <span>&nbsp;@(FailureId == 0 ? "Agregar" : "Editar")</span>
                            }
                        </button>
                        <NavLink class="btn btn-white mx-3" href="CMS/System/FailureQueryPage">
                            <span class="fas fa-chevron-left"></span>
                            &nbsp;Volver
                        </NavLink>
                    </div>
                </form>
                
            </div>
        </div>
    </div>
    <!-- MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS -->
    <!-- MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS -->
    

    <FiyiStack.Components.Shared.ComponentsForDashboard._FixedPluginForDashboard></FiyiStack.Components.Shared.ComponentsForDashboard._FixedPluginForDashboard>
    <FiyiStack.Components.Shared.ComponentsForDashboard._FooterForDashboard></FiyiStack.Components.Shared.ComponentsForDashboard._FooterForDashboard>
</div>

