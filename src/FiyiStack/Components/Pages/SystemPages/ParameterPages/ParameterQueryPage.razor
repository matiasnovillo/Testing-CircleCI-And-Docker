    #region Pagination
    private List<int> GetVisiblePages()
    {
        int MaxVisiblePages = 5;
        List<int> lstINTPages = new List<int>();

        if (PaginatedParameterDTO.TotalPages <= MaxVisiblePages + 2)
        {
            //Show all pages if there are few
            for (int i = 1; i <= PaginatedParameterDTO.TotalPages; i++)
                lstINTPages.Add(i);
        }
        else
        {
            int Current = PaginatedParameterDTO.PageIndex;
            int Start = Math.Max(2, Current - 1);
            int End = Math.Min(PaginatedParameterDTO.TotalPages - 1, Current + 1);

            lstINTPages.Add(1); //Always show the first one

            if (Start > 2)
                lstINTPages.Add(-1); // -1 will be "..."

            for (int i = Start; i <= End; i++)
                lstINTPages.Add(i);

            if (End < PaginatedParameterDTO.TotalPages - 1)
                lstINTPages.Add(-2); // -2 will be "..."

            lstINTPages.Add(PaginatedParameterDTO.TotalPages); //Always show the latest
        }

        return lstINTPages;
    }

