    #region Properties
    private List<FolderAndPagesForCMSDTO> ListFoldersAndPagesForSideNavDTO = [];

    [Parameter]
    public int ParameterId { get; set; }

    private string Message { get; set; } = "";

    [SupplyParameterFromForm]
    private Parameter Parameter { get; set; } = new();

    private bool IsSubmitting = false;

    //Error messages for inputs
    private string ErrorMessageParameterId { get; set; } = "";
    private string ErrorMessageDateTimeCreation { get; set; } = "";
    private string ErrorMessageDateTimeLastModification { get; set; } = "";
    private string ErrorMessageUserCreationId { get; set; } = "";
    private string ErrorMessageUserLastModificationId { get; set; } = "";
    private string ErrorMessageActive { get; set; } = "";
    private string ErrorMessageName { get; set; } = "";
    private string ErrorMessageValue { get; set; } = "";
    private string ErrorMessageIsPrivate { get; set; } = "";
    
    
    //FOREIGN LISTS (TABLES)
    

    //CANCELATION TOKENS
    
    #endregion

    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await base.GetUserIdFromCookies();

                await base.IsUserAvailableToUseThisPage("/CMS/System/Parameterquerypage");

                ListFoldersAndPagesForSideNavDTO = await rolemenuRepository
                    .GetAllPagesAndFoldersForCMSByRoleIdAsync(base.User!.RoleId);

                //FOREIGN LISTS (TABLES)
                

                if (ParameterId == 0)
                {
                    //Create new Parameter
                    Parameter = new();
                }
                else
                {
                    //Edit Parameter

                    Parameter = await parameterRepository
                                .GetOneByParameterIdAsync(ParameterId);

                    
                }  


                Check("");
                
            }
        }
        catch (Exception ex)
        {
            await base.CatchException(ex);

            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intente nuevamente.", "error");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Submit()
    {
        try
        {
            if (IsSubmitting)
            {
                return;
            }

            IsSubmitting = true;
            await InvokeAsync(StateHasChanged);

            if(Check("") != null)
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Atención", "No se puede guardar. Hay campos faltantes. Operación cancelada.", "warning");
                return;
            }

            if (ParameterId == 0)
            {
                //Create new Parameter
                Parameter.Active = true;
                Parameter.UserCreationId = User.UserId;
                Parameter.UserLastModificationId = User.UserId;
                Parameter.DateTimeCreation = DateTime.Now;
                Parameter.DateTimeLastModification = DateTime.Now;

                await parameterRepository
                    .AddAsync(Parameter);
  
            }
            else
            {
                //Update data
                Parameter.DateTimeLastModification = DateTime.Now;
                Parameter.UserLastModificationId = User.UserId;

                await parameterRepository
                    .UpdateAsync(Parameter);
            }
            
            NavigationManager.NavigateTo("/cms/system/parameterquerypage");
        }
        catch (Exception ex)
        {
            await base.CatchException(ex);

            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intente nuevamente.", "error");
        }
        finally
        {
            //Re-render the page
            IsSubmitting = false;

            await InvokeAsync(StateHasChanged);
        }
    }

