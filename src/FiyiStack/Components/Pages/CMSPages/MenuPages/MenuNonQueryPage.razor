@page "/cms/cms/menunonquerypage/{MenuId:int}"

@inherits FiyiStack.Components.Base.CMSBase;

@using FiyiStack.Areas.CMS.MenuBack.Repositories;
@using FiyiStack.Areas.CMS.MenuBack.Entities;
@using FiyiStack.Areas.CMS.MenuBack.DTOs;

@inject MenuRepository menuRepository;
@inject IJSRuntime IJSRuntime;

<!--FOREIGN CALLS (TABLES)-->


@if (MenuId == 0)
{
    <PageTitle>Agregar menu - CMS</PageTitle>
}
else
{
    <PageTitle>Editar menu - CMS</PageTitle>
}

<FiyiStack.Components.Shared.ComponentsForDashboard._SideNavForDashboard lstFoldersAndPagesForSideNavDTO="ListFoldersAndPagesForSideNavDTO"></FiyiStack.Components.Shared.ComponentsForDashboard._SideNavForDashboard>

<div class="main-content position-relative max-height-vh-100 h-100">
    <FiyiStack.Components.Shared.ComponentsForDashboard._NavBarForDashboard Pagina="Menu"></FiyiStack.Components.Shared.ComponentsForDashboard._NavBarForDashboard>
    <div class="container-fluid px-2 px-md-4">
        <div class="page-header min-height-300 border-radius-xl mt-4"
             style="background-image: url('img/System/Landscape.jpg');">
            <span class="mask bg-gradient-dark opacity-6"></span>
        </div>
        <div class="card card-body mx-3 mx-md-4 mt-n6">
            <div class="card-header mb-0 pb-0 px-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h3 class="mb-3 mb-md-0">
                        @if (MenuId == 0)
                        {
                            <span>Agregar menu</span>
                        }
                        else
                        {
                            <span>Editar menu</span>
                        }
                    </h3>
                    <div class="d-flex">
                        <NavLink class="btn btn-white btn-sm" href="CMS/CMS/MenuQueryPage">
                            <span class="fas fa-chevron-left"></span>
                            &nbsp;
                            Volver
                        </NavLink>
                    </div>
                </div>
                <div class="alert alert-info text-white" role="alert">
                    Los campos marcados con <span class="text-danger">*</span> son obligatorios
                </div>
                <hr class="mt-3" />
            </div>
            <div class="card-body px-4">
                <form method="post" @onsubmit="Submit"
                      @formname="menu-form" class="mb-4">
                    <AntiforgeryToken />
                    <!--Name-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="name">
                            Name
                            <span class="text-danger">*</span>
                            
                            @if(ErrorMessageName != "")
                            {
                            @((MarkupString)ErrorMessageName)
                            }
                        </label>
                        <input type="text"
                               id="name"
                               class="form-control pt-0"
                               value="@Menu!.Name"
                               @onchange="HandleNameChange" />
                    </div>
                    <!--MenuFatherId-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="menufatherid">
                            MenuFatherId
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageMenuFatherId != "")
                            {
                                @((MarkupString)ErrorMessageMenuFatherId)
                            }
                        </label>
                        <input type="number"
                        step="1" 
                        id="menufatherid"
                        class="form-control pt-0"
                        value="@Menu!.MenuFatherId"
                        @onchange="HandleMenuFatherIdChange" />
                    </div>
                    <!--URLPath-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="urlpath">
                            URLPath
                            
                            
                            @if(ErrorMessageURLPath != "")
                            {
                            @((MarkupString)ErrorMessageURLPath)
                            }
                        </label>
                        <input type="text"
                               id="urlpath"
                               class="form-control pt-0"
                               value="@Menu!.URLPath"
                               @onchange="HandleURLPathChange" />
                    </div>
                    <!--IconURLPath-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="iconurlpath">
                            IconURLPath
                            
                            
                            @if(ErrorMessageIconURLPath != "")
                            {
                            @((MarkupString)ErrorMessageIconURLPath)
                            }
                        </label>
                        <input type="text"
                               id="iconurlpath"
                               class="form-control pt-0"
                               value="@Menu!.IconURLPath"
                               @onchange="HandleIconURLPathChange" />
                    </div>
                    <!--Order-->
                    <div class="input-group input-group-static mb-5 pb-2">
                        <label for="order">
                            Order
                            <span class="text-danger">*</span>
                            
                            @if (ErrorMessageOrder != "")
                            {
                                @((MarkupString)ErrorMessageOrder)
                            }
                        </label>
                        <input type="number"
                        step="1" 
                        id="order"
                        class="form-control pt-0"
                        value="@Menu!.Order"
                        @onchange="HandleOrderChange" />
                    </div>
                    
                    <hr />
                    @((MarkupString)Message)
                    <div class="d-flex justify-content-between">
                        <button id="btn-submit" 
                        type="submit"
                        class="btn btn-success"
                        disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>&nbsp;Guardando...</span>
                            }
                            else
                            {
                                <i class="fas fa-pen"></i>
                                <span>&nbsp;@(MenuId == 0 ? "Agregar" : "Editar")</span>
                            }
                        </button>
                        <NavLink class="btn btn-white mx-3" href="CMS/CMS/MenuQueryPage">
                            <span class="fas fa-chevron-left"></span>
                            &nbsp;Volver
                        </NavLink>
                    </div>
                </form>
                
            </div>
        </div>
    </div>
    <!-- MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS MODALS FOR FOREIGN KEYS -->
