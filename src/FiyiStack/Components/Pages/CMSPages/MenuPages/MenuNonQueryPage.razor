    #region Properties
    private List<FolderAndPagesForCMSDTO> ListFoldersAndPagesForSideNavDTO = [];

    [Parameter]
    public int MenuId { get; set; }

    private string Message { get; set; } = "";

    [SupplyParameterFromForm]
    private Menu Menu { get; set; } = new();

    private bool IsSubmitting = false;

    //Error messages for inputs
    private string ErrorMessageMenuId { get; set; } = "";
    private string ErrorMessageDateTimeCreation { get; set; } = "";
    private string ErrorMessageDateTimeLastModification { get; set; } = "";
    private string ErrorMessageUserCreationId { get; set; } = "";
    private string ErrorMessageUserLastModificationId { get; set; } = "";
    private string ErrorMessageActive { get; set; } = "";
    private string ErrorMessageName { get; set; } = "";
    private string ErrorMessageMenuFatherId { get; set; } = "";
    private string ErrorMessageURLPath { get; set; } = "";
    private string ErrorMessageIconURLPath { get; set; } = "";
    private string ErrorMessageOrder { get; set; } = "";
    
    
