    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await base.GetUserIdFromCookies();

                await base.IsUserAvailableToUseThisPage("/CMS/CMS/Rolequerypage");

                ListFoldersAndPagesForSideNavDTO = await rolemenuRepository
                    .GetAllPagesAndFoldersForCMSByRoleIdAsync(base.User!.RoleId);

                //FOREIGN LISTS (TABLES)
                

                if (RoleId == 0)
                {
                    //Create new Role
                    Role = new();
                }
                else
                {
                    //Edit Role

                    Role = await roleRepository
                                .GetOneByRoleIdAsync(RoleId);

                    
                }  


                Check("");
                
            }
        }
        catch (Exception ex)
        {
            await base.CatchException(ex);

            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intente nuevamente.", "error");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Submit()
    {
        try
        {
            if (IsSubmitting)
            {
                return;
            }

            IsSubmitting = true;
            await InvokeAsync(StateHasChanged);

            if(Check("") != null)
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Atención", "No se puede guardar. Hay campos faltantes. Operación cancelada.", "warning");
                return;
            }

            if (RoleId == 0)
            {
                //Create new Role
                Role.Active = true;
                Role.UserCreationId = User.UserId;
                Role.UserLastModificationId = User.UserId;
                Role.DateTimeCreation = DateTime.Now;
                Role.DateTimeLastModification = DateTime.Now;

                await roleRepository
                    .AddAsync(Role);
  
            }
            else
            {
                //Update data
                Role.DateTimeLastModification = DateTime.Now;
                Role.UserLastModificationId = User.UserId;

                await roleRepository
                    .UpdateAsync(Role);
            }
            
            NavigationManager.NavigateTo("/cms/cms/rolequerypage");
        }
        catch (Exception ex)
        {
            await base.CatchException(ex);

            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intente nuevamente.", "error");
        }
        finally
        {
            //Re-render the page
            IsSubmitting = false;

            await InvokeAsync(StateHasChanged);
        }
    }

