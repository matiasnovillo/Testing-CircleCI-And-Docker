@using FiyiStack.Areas.CMS.UserBack.Entities;
@using FiyiStack.Components.Shared;
@using FiyiStack.Services.System
@inject NavigationManager navigationManager;
@inject CookieService cookieServie;

<aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-3 fixed-start ms-3 bg-gradient-dark d-none d-sm-none d-md-inline"
       id="sidenav-main">
    <div class="sidenav-header">
        <i class="fas fa-times p-3 cursor-pointer text-white opacity-5 position-absolute end-0 top-0 d-none d-xl-none"
           aria-hidden="true"
           id="iconSidenav"></i>
        <NavLink class="navbar-brand m-0"
                 href="/panel-de-control">
            <img src="/img/fiyistackweb/logo.png"
                 class="navbar-brand-img h-100"
                 alt="main_logo">
            <span class="ms-1 font-weight-bold text-white">
                FiyiStack
            </span>
        </NavLink>
    </div>
    <hr class="horizontal light mt-0 mb-2">
    <div class="collapse navbar-collapse  w-auto h-auto" id="sidenav-collapse-main">
        <ul class="navbar-nav">
            <li class="nav-item">
                <NavLink class="nav-link text-white"
                         role="button"
                         href="/panel-de-control">
                    <span class="sidenav-mini-icon">
                        <i class="fas fa-clipboard fa-xl"></i>
                    </span>
                    <span class="sidenav-normal ms-2 ps-1">
                        Panel de control
                    </span>
                </NavLink>
            </li>
            @if (ListFolderAndPagesForCMSDTO != null)
            {
                @foreach (FolderAndPagesForCMSDTO folderandpages in ListFolderAndPagesForCMSDTO)
                {
                    <li class="nav-item">
                        <a data-bs-toggle="collapse"
                           href="#@folderandpages.Folder.Name"
                           class="nav-link text-white"
                           aria-controls="@folderandpages.Folder.Name"
                           role="button"
                           aria-expanded="false">
                            <i class="fas fa-folder"></i>
                            <span class="nav-link-text ms-2 ps-1">
                                @folderandpages.Folder.Name
                            </span>
                        </a>
                        <div class="collapse"
                             id="@folderandpages.Folder.Name">
                            <ul class="nav">
                                @foreach (Menu Menu in folderandpages.Pages)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white"
                                               href="@Menu.URLPath">
                                            <span class="sidenav-mini-icon">
                                                @Menu.IconURLPath
                                            </span>
                                            <span class="sidenav-normal ms-2 ps-1">
                                                @Menu.Name
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            }
            <li class="nav-item">
                <NavLink class="nav-link text-white"
                     role="button"
                     @onclick=Salir
                     href="javascript:void(0);">
                    <span class="sidenav-mini-icon">
                        <i class="fas fa-right-from-bracket fa-xl"></i>
                    </span>
                    <span class="sidenav-normal ms-2 ps-1">
                        Salir
                    </span>
                </NavLink>
            </li>
        </ul>
    </div>
</aside>

@code{
    [Parameter]
    public List<FolderAndPagesForCMSDTO>? ListFolderAndPagesForCMSDTO { get; set; }

    public async Task Salir()
    {
        try
        {
            await cookieServie.RemoveUserIdCookieAsync();
            navigationManager.NavigateTo("");
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active = true,
                DateTimeCreation = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId = 1,
                UserLastModificationId = 1,
                EmergencyLevel = 1,
                Comment = "",
                Message = ex.Message,
                Source = ex.Source,
                StackTrace = ex.StackTrace
            };

            await failureRepository.AddAsync(failure);
        }
        
    }
}